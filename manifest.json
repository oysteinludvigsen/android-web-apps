{
  "name": "Atelier TextEdit",
  "short_name": "TextEdit",
  "description": "A polished text editor with syntax highlighting for 20+ file formats and PDF export.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1a1815",
  "theme_color": "#1a1815",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "text/*",
            "application/json",
            "application/xml",
            "image/svg+xml",
            ".txt", ".md", ".markdown",
            ".html", ".htm", ".css", ".js", ".mjs", ".json",
            ".xml", ".svg",
            ".csv", ".tsv",
            ".yaml", ".yml", ".toml", ".ini", ".conf", ".cfg",
            ".py", ".rb", ".php", ".rs", ".go",
            ".c", ".h", ".cpp", ".hpp", ".java",
            ".sh", ".bash", ".zsh",
            ".sql", ".log"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/plain": [".txt", ".log", ".conf", ".cfg", ".ini"],
        "text/markdown": [".md", ".markdown"],
        "text/html": [".html", ".htm"],
        "text/css": [".css"],
        "text/csv": [".csv"],
        "text/tab-separated-values": [".tsv"],
        "text/xml": [".xml"],
        "image/svg+xml": [".svg"],
        "application/json": [".json"],
        "application/javascript": [".js", ".mjs"],
        "application/x-yaml": [".yaml", ".yml"],
        "text/x-toml": [".toml"],
        "text/x-python": [".py"],
        "text/x-ruby": [".rb"],
        "text/x-php": [".php"],
        "text/x-rust": [".rs"],
        "text/x-go": [".go"],
        "text/x-c": [".c", ".h"],
        "text/x-c++": [".cpp", ".hpp"],
        "text/x-java": [".java"],
        "text/x-shellscript": [".sh", ".bash", ".zsh"],
        "application/sql": [".sql"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "auto"
  }
}
